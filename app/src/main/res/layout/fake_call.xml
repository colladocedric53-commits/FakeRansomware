<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_gradient">

    <!-- Ambient top glow -->
    <View
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_call_top_glow" />

    <ImageView
        android:id="@+id/callSkull"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="start|top"
        android:layout_margin="16dp"
        android:alpha="0.25"
        android:src="@drawable/ic_skull"
        android:clickable="true"
        android:contentDescription="Skull" />

    <!-- Incoming Call View -->
    <LinearLayout
        android:id="@+id/incomingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/incomingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:gravity="center"
            android:text="incoming call"
            android:textColor="#a0a0a8"
            android:textSize="15sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.05" />

        <!-- Avatar with glow ring -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="56dp">

            <!-- Pulse rings behind -->
            <PulseView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />

            <!-- Avatar circle -->
            <FrameLayout
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_avatar_ring">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="?"
                    android:textColor="#d0d0d8"
                    android:textSize="60sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-light" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="UNKNOWN CALLER"
            android:textColor="#ffffff"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-light"
            android:text="+1 (917) 555-0134"
            android:textColor="#909098"
            android:textSize="17sp"
            android:letterSpacing="0.03" />

        <!-- Encrypted badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_encrypted_badge"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="4dp"
            android:paddingEnd="10dp"
            android:paddingBottom="4dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="#44AA44" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="encrypted line"
                android:textColor="#55555f"
                android:textSize="11sp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Call Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="60dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Decline -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/declineBtn"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_marginEnd="52dp"
                    android:background="@drawable/circle_red"
                    android:contentDescription="Decline"
                    android:src="@drawable/ic_call_end"
                    android:scaleType="center"
                    android:elevation="8dp"
                    android:padding="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="52dp"
                    android:text="Decline"
                    android:textColor="#808088"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <!-- Accept -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/acceptBtn"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:background="@drawable/circle_green"
                    android:contentDescription="Answer"
                    android:src="@drawable/ic_call"
                    android:scaleType="center"
                    android:elevation="8dp"
                    android:padding="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Accept"
                    android:textColor="#808088"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- In-Call View -->
    <LinearLayout
        android:id="@+id/inCallView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_call_gradient"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Avatar (smaller) -->
        <FrameLayout
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="56dp">

            <FrameLayout
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_avatar_ring">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="?"
                    android:textColor="#d0d0d8"
                    android:textSize="40sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-light" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="UNKNOWN CALLER"
            android:textColor="#ffffff"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-light"
            android:text="+1 (917) 555-0134"
            android:textColor="#909098"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/callTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-light"
            android:text="00:00"
            android:textColor="#606068"
            android:textSize="15sp"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/callCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:alpha="0.0"
            android:fontFamily="sans-serif-light"
            android:text=""
            android:textColor="#ffcc00"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Call Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Mute -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnMute"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginEnd="22dp"
                    android:background="@drawable/bg_btn_call_control"
                    android:contentDescription="Mute"
                    android:src="@drawable/ic_mic_off"
                    android:scaleType="center"
                    android:padding="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="22dp"
                    android:text="mute"
                    android:textColor="#707078"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <!-- Keypad -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnPad"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginEnd="22dp"
                    android:background="@drawable/bg_btn_call_control"
                    android:contentDescription="Keypad"
                    android:src="@drawable/ic_dialpad"
                    android:scaleType="center"
                    android:padding="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="22dp"
                    android:text="keypad"
                    android:textColor="#707078"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>

            <!-- Speaker -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageButton
                    android:id="@+id/btnSpeaker"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_btn_call_control"
                    android:contentDescription="Speaker"
                    android:src="@drawable/ic_volume_up"
                    android:scaleType="center"
                    android:padding="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="speaker"
                    android:textColor="#707078"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-light" />
            </LinearLayout>
        </LinearLayout>

        <!-- Hang up -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="50dp">

            <ImageButton
                android:id="@+id/hangupBtn"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center"
                android:background="@drawable/circle_red"
                android:contentDescription="End call"
                android:src="@drawable/ic_call_end"
                android:scaleType="center"
                android:elevation="8dp"
                android:padding="20dp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
