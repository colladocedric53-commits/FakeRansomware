<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.china.fakeransom.FxBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top glow -->
    <View
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_payment_top_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="12dp"
        android:background="@drawable/bg_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp"
        android:elevation="8dp">

        <!-- Header with skull and close indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/paymentSkull"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:alpha="0.35"
                android:src="@drawable/ic_skull"
                android:clickable="true"
                android:contentDescription="Exit" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SECURE PAYMENT GATEWAY"
                android:textColor="#55555f"
                android:textSize="9sp"
                android:letterSpacing="0.2"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#22FF2222" />

        <!-- Warning Icon -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/ic_warning" />

        <!-- Title -->
        <TextView
            android:id="@+id/paymentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.12"
            android:text="CONFIRM PAYMENT"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black"
            android:shadowColor="#66FF0000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="12" />

        <!-- Amount -->
        <TextView
            android:id="@+id/paymentAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.05"
            android:text="0.05 BTC — $3,872.10 (LIVE RATE)"
            android:textColor="#ffcc00"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#44FFCC00"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="8" />

        <!-- BTC Address -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_address_box"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BITCOIN ADDRESS"
                android:textColor="#55AA88"
                android:textSize="8sp"
                android:letterSpacing="0.2"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/paymentAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.02"
                android:text="1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVDemonstration"
                android:textColor="#88ffaa"
                android:textSize="11sp"
                android:gravity="center"
                android:textIsSelectable="false" />
        </LinearLayout>

        <!-- QR Code Frame -->
        <FrameLayout
            android:id="@+id/qrSlot"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_qr_frame"
            android:elevation="4dp" />

        <!-- Payment Progress -->
        <TextView
            android:id="@+id/paymentProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.05"
            android:text="Confirming on network... 0/6"
            android:textColor="#88aaff"
            android:textSize="12sp" />

        <!-- Progress indicator dots -->
        <LinearLayout
            android:id="@+id/confirmDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:id="@+id/dot1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_margin="3dp"
                android:background="#3388aaff" />
            <View
                android:id="@+id/dot2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_margin="3dp"
                android:background="#3388aaff" />
            <View
                android:id="@+id/dot3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_margin="3dp"
                android:background="#3388aaff" />
            <View
                android:id="@+id/dot4"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_margin="3dp"
                android:background="#3388aaff" />
            <View
                android:id="@+id/dot5"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_margin="3dp"
                android:background="#3388aaff" />
            <View
                android:id="@+id/dot6"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_margin="3dp"
                android:background="#3388aaff" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Expiry warning -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_expiry_warn"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠ TIME REMAINING ⚠"
                android:textColor="#AA4444"
                android:textSize="9sp"
                android:letterSpacing="0.2"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/paymentExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:text="WALLET EXPIRES IN 4:59"
                android:textColor="#ff4444"
                android:textSize="18sp"
                android:textStyle="bold"
                android:shadowColor="#66FF0000"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
