<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.china.fakeransom.FxBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="14dp"
        android:background="@drawable/bg_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/paymentSkull"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:alpha="0.30"
            android:text="☠"
            android:textColor="#ffffff"
            android:textSize="14sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#ff22222e"/>

        <TextView
            android:id="@+id/paymentTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.10"
            android:text="CONFIRM PAYMENT"
            android:textColor="#ffffff"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/paymentAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.04"
            android:text="0.05 BTC — $3,872.10 (LIVE RATE)"
            android:textColor="#ffcc00"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/paymentAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.04"
            android:text="1BvBMSEYstWetqTFn5Au4m4GFg7xJaNVDemonstration"
            android:textColor="#88ffaa"
            android:textSize="12sp"/>

        <FrameLayout
            android:id="@+id/qrSlot"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/paymentProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:text="Confirming on network... 0/6"
            android:textColor="#88aaff"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/paymentExpiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:letterSpacing="0.05"
            android:text="WALLET EXPIRES IN 4:59"
            android:textColor="#ff4444"
            android:textSize="15sp"
            android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>
