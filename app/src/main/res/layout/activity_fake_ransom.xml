<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08090d"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MOBILE THREAT SIMULATOR"
            android:textColor="#ff4545"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SECURITY AWARENESS EXERCISE • SAFE DEMO"
            android:textColor="#f4c45e"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Privacy notice: If you grant access, this demo displays up to 8 photo names, 8 download names on older Android versions, and 8 contact names. It does not open file contents, change files, encrypt, delete, or upload anything."
            android:textColor="#d7dce5"
            android:textSize="13sp"
            android:background="#202631"
            android:padding="12dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="READY"
            android:textColor="#ff5555"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingTop="18dp"
            android:paddingBottom="10dp" />

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DEMO MODE • NO FILES WILL BE CHANGED"
            android:textColor="#f4c45e"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="8dp" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/terminalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="230dp"
            android:layout_marginTop="14dp"
            android:background="#101820"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:textColor="#70f59a"
            android:textSize="12sp"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/ransomNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="14dp"
            android:background="#32151a"
            android:padding="14dp"
            android:textColor="#ffb0b0"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/victimInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#9ba8ba"
            android:textSize="12sp"
            android:paddingTop="10dp" />

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="START SIMULATION" />

        <Button
            android:id="@+id/soundButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SOUND: ON" />

        <Button
            android:id="@+id/exitButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EXIT DEMO" />
    </LinearLayout>
</ScrollView>
