<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.china.fakeransom.FxBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D90A0000"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/skullGlyph"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:alpha="0.40"
                android:src="@drawable/ic_skull"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Skull" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/cameraBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rec_badge"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="● LIVE"
                android:textColor="#ff3333"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Status Title -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:letterSpacing="0.12"
            android:shadowColor="#ff0000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="24"
            android:text="SYSTEM LOCKED"
            android:textColor="#ff2222"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <!-- Subtitle warning -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:text="⚠ UNAUTHORIZED ACCESS DETECTED ⚠"
            android:textColor="#FFAA0000"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:textStyle="bold" />

        <!-- Terminal Window -->
        <LinearLayout
            android:id="@+id/terminalWindow"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_terminal"
            android:orientation="vertical">

            <!-- Terminal Title Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#331A0000"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="#FF4444" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="5dp"
                    android:background="#FFAA00" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="5dp"
                    android:background="#44AA44" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="root@localhost:~#"
                    android:textColor="#88FF3333"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/terminalScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:padding="10dp">

                <TextView
                    android:id="@+id/terminalText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#33ff55"
                    android:textSize="11sp"
                    android:shadowColor="#8800FF00"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="4" />
            </ScrollView>
        </LinearLayout>

        <!-- Progress Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENCRYPTION PROGRESS"
                    android:textColor="#AAFF4444"
                    android:textSize="9sp"
                    android:letterSpacing="0.15"
                    android:fontFamily="monospace" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/progressPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#FF6644"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="4dp"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_fill"
                android:indeterminateOnly="false" />
        </LinearLayout>

        <!-- Countdown Timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_countdown_box"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠ FILES PERMANENTLY DELETED IN ⚠"
                android:textColor="#FF664444"
                android:textSize="9sp"
                android:letterSpacing="0.2"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/countdownText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:shadowColor="#ff6600"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="16"
                android:text="48:00:00"
                android:textColor="#ffcc00"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Victim Info -->
        <TextView
            android:id="@+id/victimInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:textColor="#cc6666"
            android:textSize="10sp"
            android:letterSpacing="0.05" />

        <!-- Payment Button -->
        <Button
            android:id="@+id/paymentBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_payment_btn"
            android:letterSpacing="0.12"
            android:text="OPEN PAYMENT PORTAL"
            android:textAllCaps="true"
            android:textColor="#ffffff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:elevation="6dp"
            android:stateListAnimator="@null" />

        <!-- Ransom Note -->
        <TextView
            android:id="@+id/ransomNote"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:lineSpacingExtra="3dp"
            android:text=""
            android:textColor="#dd4444"
            android:textSize="12sp"
            android:gravity="center"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Interlude Overlay -->
    <FrameLayout
        android:id="@+id/interludeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0A1F44"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.china.fakeransom.FxBackgroundView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:tag="blue" />

        <!-- Radial glow center -->
        <View
            android:layout_width="300dp"
            android:layout_height="300dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_warning_glow" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="30dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_warning"
                android:alpha="0.9" />

            <View
                android:layout_width="180dp"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:background="#66ffd700" />

            <TextView
                android:id="@+id/interludeText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text=""
                android:textColor="#ffd700"
                android:textSize="14sp"
                android:shadowColor="#66ffd700"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10" />

            <View
                android:layout_width="180dp"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:background="#66ffd700" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/borderFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Reboot Overlay -->
    <FrameLayout
        android:id="@+id/rebootOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <com.china.fakeransom.FxBackgroundView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.5" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="30dp">

            <ProgressBar
                android:id="@+id/rebootSpinner"
                style="?android:attr/progressBarStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="#666666" />

            <TextView
                android:id="@+id/rebootText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="..."
                android:textColor="#aaaaaa"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
