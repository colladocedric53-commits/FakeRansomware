<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#8B0000"
                android:endColor="#5A0000" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#FF4444"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#CC1100"
                android:centerColor="#AA0000"
                android:endColor="#770000" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#FF3333"/>
        </shape>
    </item>
</selector>
